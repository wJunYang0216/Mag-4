TEXT 48 2370 Left 2 ;I_ADC = about 0.99 V + 1.5 V/A. REF1=3.3 V, REF2=GND. MCU ADC assumed 3.3 V.
TEXT 48 2470 Left 2 !V5 V5 0 5\n.param RC=11.430016 LC=25.92669m CP=1n RD=10k\nVRESET RESET 0 PWL(0 3.3 40m 3.3 40.001m 0)\n.include "vendor/selected_diodes.lib"\nVPOL POL 0 PWL(0 0 5m 0 5.001m 5 25m 5 25.001m 0)\nVTOP TG 0 PWL(0 5 4.9m 5 4.901m 0 25.1m 0 25.101m 5)\nVDAMP DP 0 PWL(0 3.3 37m 3.3 37.001m 0)\nVSHUNT SH 0 PWL(0 3.3 38.98m 3.3 38.981m 0)\nVRX RX 0 PWL(0 0 39m 0 39.001m 3.3)\n.options plotwinsize=0 method=gear\n.tran 0 70m 0 100n\n.save V(VBAT) V(TOP) V(BOTTOM) V(PRE) V(RX_IN) V(G1) V(G4) V(G5) I(LCOIL) I(VBAT) V(FF) I(M4) I(M1) I(M5)\n.meas TRAN I_POL FIND I(LCOIL) AT=24m\n.meas TRAN BOTTOM_MAX MAX V(BOTTOM)\n.meas TRAN BOTTOM_MIN MIN V(BOTTOM)\n.meas TRAN TOP_MIN MIN V(TOP)\n.meas TRAN RX_BLANK MAX abs(V(RX_IN)) FROM 0 TO 38.98m\n.meas TRAN RX_ACQ MAX abs(V(RX_IN)) FROM 60m TO 70m\n.meas TRAN G1_MAX MAX V(G1)\n.meas TRAN G4_MIN MIN V(G4,VBAT)\n.meas TRAN G4_MAX MAX V(G4,VBAT)\n.meas TRAN I_SUPPLY_MAX MAX (-I(VBAT))\n.model IRF530 VDMOS(Rg=3 Vto=4 Rd=50m Rs=12m Rb=60m Kp=5 lambda=.01 Cgdmax=1n Cgdmin=.26n Cgs=.2n Cjo=.4n Is=52p ksubthres=.1 mfg=International_Rectifier Vds=100 Ron=160m Qg=26n)\n.model IRF9640 VDMOS(pchan Rg=3 Vto=-3.5 Rd=.15 Rs=.15 Rb=.15 Kp=8 lambda=.01 mtriode=.5 Cgdmax=1.5n Cgdmin=.07n Cgs=1n Cjo=1n Is=38p ksubthres=.1 mfg=International_Rectifier Vds=-200 Ron=.5 Qg=44n)\n.include "vendor/ina241_adapter.lib"\n.save V(COIL_TOP) V(CS_OUT) V(I_ADC) V(VLOG) I(RSHUNT)\n.meas TRAN ADC_24 FIND V(I_ADC) AT=24m\n.meas TRAN SHUNT_24 FIND I(RSHUNT) AT=24m\n.meas TRAN SHUNT_POWER_24 FIND (V(TOP,COIL_TOP)*I(RSHUNT)) AT=24m
